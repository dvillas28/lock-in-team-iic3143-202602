{
  "name": "lms-multi-tenant-universitario",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test:e2e": "pnpm --dir e2e run test",
    "test:e2e:smoke": "pnpm --dir e2e run test:smoke",
    "test:e2e:harness": "pnpm --dir e2e run test:harness",
    "docs:api": "python3 -m http.server 8080 --bind 127.0.0.1 --directory dist/api-catalog",
    "docs:api:lint": "redocly lint docs/reference/openapi/openapi.yaml",
    "build": "pnpm --dir frontend build && pnpm --dir backend build",
    "lint": "pnpm --dir frontend lint && pnpm --dir backend lint",
    "test": "pnpm --dir backend test",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "pnpm --dir backend start:dev",
    "docs:api:build": "pnpm --dir backend build && node scripts/api-catalog.mjs",
    "docs:api:test": "pnpm --dir backend build && node --test scripts/api-catalog.test.mjs",
    "test:e2e:f1": "pnpm --dir e2e run test:f1",
    "test:e2e:f2": "pnpm --dir e2e run test:f2"
  },
  "devDependencies": {
    "@redocly/cli": "1.25.11",
    "swagger-ui-dist": "5.34.0"
  }
}
