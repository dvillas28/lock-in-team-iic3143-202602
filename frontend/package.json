{
  "name": "academix-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "api:generate": "openapi-typescript ../docs/reference/openapi/openapi.yaml -o src/lib/api/schema.d.ts",
    "api:check": "pnpm api:generate --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "next": "16.3.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
