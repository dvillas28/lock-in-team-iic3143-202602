# Used when the frontend runs directly on the host.
API_URL=http://localhost:3001

# Optional for browser API calls; only a public backend URL, never secrets.
# Next.js embeds NEXT_PUBLIC_API_URL at build time. Server calls keep using API_URL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Exact frontend origins (JSON array); production must list the UC/UTFSM HTTPS origins.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Backend listening port.
PORT=3001

# Version reported by GET /health.
APP_VERSION=0.1.0

# Shared PostgreSQL used by every Institution in local development.
POSTGRES_DB=academix
POSTGRES_USER=academix
POSTGRES_PASSWORD=academix_dev
# Local Compose runtime password; match DATABASE_URL when running backend on host.
RUNTIME_PASSWORD=runtime_dev

# Used when the backend runs directly on the host. Docker Compose uses the
# equivalent URL with `postgres` as the service hostname.
DATABASE_URL=postgresql://academix_runtime:runtime_dev@localhost:5432/academix
MIGRATION_DATABASE_URL=postgresql://academix:academix_dev@localhost:5432/academix
DEMO_DATA_ENABLED=false
DEMO_ADOPT_LEGACY=false
DEMO_OPERATOR_REF=
# Initial demo secrets: DEMO_{UC,UTFSM}_{SUPERADMIN,ADMIN,TEACHER,ASSISTANT,STUDENT}_PASSWORD
# Supply via secure environment; never committed.

# Dedicated disposable integration database; never falls back to DATABASE_URL.
TEST_RUNTIME_DATABASE_URL=
TEST_DATABASE_URL=

# Manual db:seed only; provide all five 8–30 Unicode-character passwords.
DEMO_UC_PASSWORD=
DEMO_UTFSM_PASSWORD=
DEMO_MULTI_PASSWORD=
DEMO_REVOKED_PASSWORD=
DEMO_INACTIVE_PASSWORD=

# Required: canonical base64 encoding of at least 32 random bytes; no default.
AUTH_JWT_SECRET=
