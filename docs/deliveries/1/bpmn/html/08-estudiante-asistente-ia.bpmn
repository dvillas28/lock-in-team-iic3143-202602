        <dc:Bounds x="1504.0" y="268.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="1584.0" y="600.0" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1512" y="644" width="184" height="52" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
