<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_01-administrador-institucional" targetNamespace="https://academix.example/bpmn">
  <bpmn:process id="Process" name="Administrador institucional · habilitar el semestre" isExecutable="false">
    <bpmn:documentation>Precondición: administrador autorizado en una universidad existente (modelo 00)
Los usuarios pueden crearse, editarse, activarse o desactivarse. Los roles se asignan dentro del tenant y del curso o sección.
El orden describe un alta semestral; sobre registros existentes se entra directamente a la gestión correspondiente, con permiso validado.
RF3–RF5 · US5–US8 · design-doc-entrega-1.md: Usuarios</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_0" name="Administrador institucional">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Plataforma AcademiX">
        <bpmn:flowNodeRef>v</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Preparar periodo">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="u" name="Gestionar usuarios del tenant">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p" name="Crear periodo académico">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="c" name="Crear curso semestral">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="sec" name="Crear secciones y asignar responsables">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="i" name="Inscribir estudiantes y cuerpo docente">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="v" name="Validar relaciones y guardar inscripciones">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Oferta académica habilitada">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="s" targetRef="u" name="" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="u" targetRef="p" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="p" targetRef="c" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="c" targetRef="sec" name="" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="sec" targetRef="i" name="" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="i" targetRef="v" name="" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="v" targetRef="e" name="" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="University" name="Operación académica de una universidad (tenant)" processRef="Process" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="University_di" bpmnElement="University" isHorizontal="true">
        <dc:Bounds x="8" y="176" width="1712" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true">
        <dc:Bounds x="40" y="176" width="1680" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="40" y="476" width="1680" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="220.0" y="300.0" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="148" y="344" width="184" height="52" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="u_di" bpmnElement="u">
        <dc:Bounds x="364.0" y="268.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p_di" bpmnElement="p">
        <dc:Bounds x="604.0" y="268.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_di" bpmnElement="c">
        <dc:Bounds x="844.0" y="268.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sec_di" bpmnElement="sec">
        <dc:Bounds x="1084.0" y="268.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="i_di" bpmnElement="i">
        <dc:Bounds x="1324.0" y="268.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="v_di" bpmnElement="v">
        <dc:Bounds x="1324.0" y="568.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="1140.0" y="600.0" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1068" y="644" width="184" height="52" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="260.0" y="320" />
        <di:waypoint x="364.0" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="564.0" y="320" />
        <di:waypoint x="604.0" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="804.0" y="320" />
        <di:waypoint x="844.0" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="1044.0" y="320" />
        <di:waypoint x="1084.0" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1284.0" y="320" />
        <di:waypoint x="1324.0" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1424" y="372.0" />
        <di:waypoint x="1424" y="568.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1324.0" y="620" />
        <di:waypoint x="1180.0" y="620" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>