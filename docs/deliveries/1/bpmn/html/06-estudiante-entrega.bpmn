          <dc:Bounds x="612" y="644" width="184" height="52" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="no_di" bpmnElement="no">
        <dc:Bounds x="684.0" y="300.0" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="612" y="232" width="184" height="52" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="u_di" bpmnElement="u">
        <dc:Bounds x="844.0" y="268.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="save_di" bpmnElement="save">
        <dc:Bounds x="1084.0" y="568.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ok_di" bpmnElement="ok">
        <dc:Bounds x="1376.0" y="592.0" width="56" height="56" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1312" y="520" width="184" height="52" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="state_di" bpmnElement="state">
        <dc:Bounds x="1504.0" y="268.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="1584.0" y="600.0" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1512" y="644" width="184" height="52" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="260.0" y="320" />
        <di:waypoint x="312" y="320" />
        <di:waypoint x="312" y="620" />
        <di:waypoint x="364.0" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="564.0" y="620" />
        <di:waypoint x="676.0" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="704" y="592.0" />
        <di:waypoint x="704" y="340.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="672" y="448" width="144" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="732.0" y="620" />
        <di:waypoint x="788" y="620" />
        <di:waypoint x="788" y="320" />
        <di:waypoint x="844.0" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="752" y="272" width="144" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1044.0" y="320" />
        <di:waypoint x="1064" y="320" />
        <di:waypoint x="1064" y="620" />
        <di:waypoint x="1084.0" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1284.0" y="620" />
        <di:waypoint x="1376.0" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1432.0" y="620" />
        <di:waypoint x="1468" y="620" />
