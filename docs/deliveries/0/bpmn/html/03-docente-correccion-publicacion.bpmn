<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_03-docente-correccion-publicacion" targetNamespace="https://academix.example/bpmn">
  <bpmn:process id="Process" name="Docente · corregir y liberar calificaciones" isExecutable="false">
    <bpmn:documentation>Precondición: entrega recibida y permisos vigentes · corrección y publicación son acciones distintas
El ayudante solo corrige cuando tiene permiso; la liberación manual corresponde al docente. Cada estudiante ve únicamente sus resultados.
Se auditan actor, fecha, acción y valores anterior/nuevo. Publicar no exige completar todas las correcciones; se mantiene el estado parcial.
RF12–RF16, RF19, RF22 · US15, US17–US18, US21 · mockup-teacher-gradebook.png</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_0" name="Docente o ayudante autorizado">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Plataforma AcademiX">
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>avg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Docente">
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Corregir o revisar notas">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="r" name="Registrar o revisar nota y comentarios">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="save" name="Guardar corrección oculta y auditar">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="avg" name="Calcular promedios o advertir pesos inválidos">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g" name="¿Liberar ahora?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="wait" name="Nota guardada sin publicar">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="u" name="Seleccionar notas y confirmar liberación">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="pub" name="Publicar notas y comentarios; auditar">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Resultados publicados">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="s" targetRef="r" name="" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="r" targetRef="save" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="save" targetRef="avg" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="avg" targetRef="g" name="" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="g" targetRef="wait" name="No" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="g" targetRef="u" name="Sí" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="u" targetRef="pub" name="" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="pub" targetRef="e" name="" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="University" name="Operación académica de una universidad (tenant)" processRef="Process" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="University_di" bpmnElement="University" isHorizontal="true">
        <dc:Bounds x="8" y="176" width="1712" height="900" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true">
        <dc:Bounds x="40" y="176" width="1680" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="40" y="476" width="1680" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="40" y="776" width="1680" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="220.0" y="300.0" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="148" y="344" width="184" height="52" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r_di" bpmnElement="r">
        <dc:Bounds x="364.0" y="268.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="save_di" bpmnElement="save">
        <dc:Bounds x="624.0" y="568.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="avg_di" bpmnElement="avg">
        <dc:Bounds x="884.0" y="568.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_di" bpmnElement="g">
        <dc:Bounds x="1216.0" y="892.0" width="56" height="56" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1152" y="944" width="184" height="52" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_di" bpmnElement="wait">
        <dc:Bounds x="1224.0" y="600.0" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1152" y="532" width="184" height="52" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="u_di" bpmnElement="u">
        <dc:Bounds x="1344.0" y="868.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pub_di" bpmnElement="pub">
        <dc:Bounds x="1344.0" y="568.0" width="200" height="104" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="1620.0" y="600.0" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1548" y="644" width="184" height="52" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="260.0" y="320" />
        <di:waypoint x="364.0" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="564.0" y="320" />
        <di:waypoint x="592" y="320" />
        <di:waypoint x="592" y="620" />
        <di:waypoint x="624.0" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="824.0" y="620" />
        <di:waypoint x="884.0" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="1084.0" y="620" />
        <di:waypoint x="1152" y="620" />
        <di:waypoint x="1152" y="920" />
        <di:waypoint x="1216.0" y="920" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1244" y="892.0" />
        <di:waypoint x="1244" y="640.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1212" y="748" width="144" height="24" />
