      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="928" y="388.0" />
        <di:waypoint x="928" y="288" />
        <di:waypoint x="1132.0" y="288" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="964" y="240" width="144" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="956.0" y="416" />
