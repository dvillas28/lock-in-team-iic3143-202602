<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_05-estudiante-actividad" targetNamespace="https://academix.example/bpmn">
  <bpmn:process id="Process" name="Estudiante · consultar su actividad académica" isExecutable="false">
    <bpmn:documentation>Precondición: estudiante autenticado e inscrito en el contexto consultado (modelo 00)
El dashboard lista cursos activos y pendientes por vencimiento; el equipo de la sección muestra nombre y rol sin exponer otros contextos.
Cada consulta elige una acción y puede repetirse. El lector PDF es una extensión inicial; calendario, alertas e IA siguen siendo opcionales.
RF10, RF18, RF20–RF21 · US1–US3, US12, US24, US26, US30 · mockup-dashboard.png</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_0" name="Estudiante">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>course</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Plataforma AcademiX">
        <bpmn:flowNodeRef>dash</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Consultar actividad">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="dash" name="Mostrar cursos, pendientes y anuncios">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="course" name="Elegir curso y consultar equipo de la sección">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g" name="¿Qué acción realizar?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="m" name="Consultar material publicado y leer PDF">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a" name="Entregar evaluación (ver modelo 06)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="n" name="Consultar calificaciones (ver modelo 07)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="merge" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e" name="Consulta completada">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="s" targetRef="dash" name="" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="dash" targetRef="course" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="course" targetRef="g" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="g" targetRef="m" name="Material" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="g" targetRef="a" name="Entrega" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="g" targetRef="n" name="Notas" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="m" targetRef="merge" name="" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="a" targetRef="merge" name="" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="n" targetRef="merge" name="" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="merge" targetRef="e" name="" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="University" name="Operación académica de una universidad (tenant)" processRef="Process" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="University_di" bpmnElement="University" isHorizontal="true">
        <dc:Bounds x="8" y="176" width="1712" height="864" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true">
        <dc:Bounds x="40" y="176" width="1680" height="432" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="40" y="608" width="1680" height="432" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="220.0" y="396.0" width="40" height="40" />
