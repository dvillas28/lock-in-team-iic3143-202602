{
  "name": "academix-e2e",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test": "tsx runner/run.ts",
    "test:smoke": "tsx runner/run.ts --grep @smoke",
    "test:regression": "tsx runner/run.ts --grep-invert @extended",
    "test:extended": "tsx runner/run.ts",
    "test:headed": "tsx runner/run.ts --headed",
    "test:ui": "tsx runner/run.ts --ui",
    "typecheck": "tsc --noEmit",
    "test:harness": "node --import tsx --test unit/*.test.ts",
    "test:list": "playwright test --list --project=chromium --reporter=line",
    "lint": "eslint .",
    "report": "tsx runner/show-report.ts",
    "coverage": "tsx runner/coverage.ts",
    "test:f1": "tsx runner/run.ts ops.spec.ts auth.smoke.spec.ts",
    "test:f2": "tsx runner/run.ts auth.entry.spec.ts auth.smoke.spec.ts public.spec.ts catalog.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
